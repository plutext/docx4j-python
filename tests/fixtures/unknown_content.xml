<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  CR-001 section 7 and 9: a part with content the schema does not know, so
  that the fork's ParserConfig(skipped_report=True) has something to report.
  Everything here is valid WordprocessingML except the two deliberate
  intruders, which are in a namespace no OOXML schema declares:

    <zz:widget>    an element, inside w:body, after the first w:p
    zz:flavour     an attribute, on the second w:p

  Lenient parsing drops both without a trace; the report is what makes the
  loss visible, and scripts/roundtrip.py fails on it.
-->
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
            xmlns:zz="urn:docx4j-python:test:unknown">
  <w:body>
    <w:p>
      <w:r>
        <w:t>known</w:t>
      </w:r>
    </w:p>
    <zz:widget id="1">
      <zz:inner>dropped with its parent</zz:inner>
    </zz:widget>
    <w:p zz:flavour="vanilla">
      <w:r>
        <w:t xml:space="preserve">also known </w:t>
      </w:r>
    </w:p>
  </w:body>
</w:document>
