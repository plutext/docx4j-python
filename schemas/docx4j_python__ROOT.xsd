<?xml version="1.0" encoding="utf-8"?>
<!--
  docx4j-python: the one entry point codegen/generate.sh hands the generator.

  Not a docx4j schema. docx4j's build runs XJC once per part family with its own
  <jaxb:package> binding; the Python generator takes a single SOURCE, so the
  entry points are collected here instead. Everything below is reached by
  import, and each import's own closure comes with it.

    wml/wml.xsd                                 WordprocessingML and its 95-file closure
    relationships.xsd                           the .rels parts             (CR-002 section 9)
    docProps/opc-coreProperties.xsd             docProps/core.xml, and Dublin Core with it
    docProps/shared-documentPropertiesExtended.xsd   docProps/app.xml
    docProps/shared-documentPropertiesCustom.xsd     docProps/custom.xml
    vml/vml-main.xsd                            VML, under w:pict and w:object  (CR-012 Phase C)
    vml/vml-officedrawing.xsd                   o:, the Office VML extensions
    vml/vml-wordprocessingdrawing.xsd           w10:, Word's
    vml/vml-spreadsheetDrawing.xsd              x:, Excel's (imported by vml-main.xsd)
    vml/vml-presentationDrawing.xsd             pvml:, PowerPoint's (likewise)

  The two docProps property schemas both import the variant types, which is
  where vt:vector and friends come from. The five VML schemas import one
  another, and wml/wml.xsd, which imports none of them: CT_Picture's and
  CT_Object's lax wildcards name the VML and o: namespaces without an import.
  docx4j's vml/vml__ROOT.xsd, the root of a vmlDrawing part (<xml> in no
  namespace, docx4j CR-026), is not copied: that part is SpreadsheetML's and
  PresentationML's, and WordprocessingML never holds one.
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	elementFormDefault="qualified" attributeFormDefault="qualified"
	blockDefault="#all">

	<xsd:import id="w" namespace="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
		schemaLocation="wml/wml.xsd"/>

	<xsd:import id="rel" namespace="http://schemas.openxmlformats.org/package/2006/relationships"
		schemaLocation="relationships.xsd"/>

	<xsd:import id="cp" namespace="http://schemas.openxmlformats.org/package/2006/metadata/core-properties"
		schemaLocation="docProps/opc-coreProperties.xsd"/>

	<xsd:import id="properties" namespace="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties"
		schemaLocation="docProps/shared-documentPropertiesExtended.xsd"/>

	<xsd:import id="prop" namespace="http://schemas.openxmlformats.org/officeDocument/2006/custom-properties"
		schemaLocation="docProps/shared-documentPropertiesCustom.xsd"/>

	<xsd:import id="v" namespace="urn:schemas-microsoft-com:vml"
		schemaLocation="vml/vml-main.xsd"/>

	<xsd:import id="o" namespace="urn:schemas-microsoft-com:office:office"
		schemaLocation="vml/vml-officedrawing.xsd"/>

	<xsd:import id="w10" namespace="urn:schemas-microsoft-com:office:word"
		schemaLocation="vml/vml-wordprocessingdrawing.xsd"/>

	<xsd:import id="xvml" namespace="urn:schemas-microsoft-com:office:excel"
		schemaLocation="vml/vml-spreadsheetDrawing.xsd"/>

	<xsd:import id="pvml" namespace="urn:schemas-microsoft-com:office:powerpoint"
		schemaLocation="vml/vml-presentationDrawing.xsd"/>

</xsd:schema>
